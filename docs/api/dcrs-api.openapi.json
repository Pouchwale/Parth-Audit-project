{
  "openapi": "3.1.0",
  "info": {
    "title": "DCRS API for the Audit Assistant",
    "version": "1.0.0",
    "summary": "Read and change DCRS data as a signed-in person, through DCRS's own rules.",
    "description": "The Digital Controlled Record System's API for another server acting as a signed-in person (REQUIREMENTS §83). Sign in with POST /api/auth/login; send the session token (the dcrs_session cookie's value) as `Authorization: Bearer <token>` on every /api/v1 call, and name the calling server in `X-Client-Name`. Everything is JSON except the PDF. The person's departments decide what may be read and changed, exactly as in DCRS itself. See docs/chatbot-integration.md."
  },
  "servers": [
    {
      "url": "http://{host}:{port}",
      "description": "The DCRS server on the factory network (API_PORT, 4000 unless set).",
      "variables": {
        "host": {
          "default": "localhost",
          "description": "The DCRS computer's name or address."
        },
        "port": {
          "default": "4000"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    }
  ],
  "tags": [
    {
      "name": "Sign-in",
      "description": "DCRS's own sign-in, unchanged."
    },
    {
      "name": "Read",
      "description": "READ: changes nothing."
    },
    {
      "name": "Change",
      "description": "CHANGE: changes DCRS data, as the person, with a line in the record's history and in the activity log."
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Sign-in"
        ],
        "operationId": "login",
        "summary": "Sign in as a person (DCRS's own sign-in, unchanged)",
        "description": "The session token is the value of the `dcrs_session` cookie in the `Set-Cookie` header of the answer. It lasts 7 days. Send it back as `Authorization: Bearer <token>` (or as the cookie). Eight wrong passwords for one email in 10 minutes are refused with 429 for the rest of those 10 minutes.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "person@gpp.local",
                "password": "their password"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "headers": {
              "Set-Cookie": {
                "description": "dcrs_session=<token>; Max-Age=604800; Path=/; HttpOnly; SameSite=Lax",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "user": {
                    "id": "3f1c2d4e-5b6a-4c7d-8e9f-0a1b2c3d4e5f",
                    "name": "Kajal Shah",
                    "email": "kajal.shah@gpp.local",
                    "role": "staff",
                    "departments": [
                      "QA"
                    ]
                  },
                  "features": {
                    "demoMode": false,
                    "signup": false,
                    "assistant": true
                  },
                  "mustChangePassword": false
                }
              }
            }
          },
          "400": {
            "description": "Email or password missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email and password are required."
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid email or password."
                }
              }
            }
          },
          "403": {
            "description": "The account is switched off.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This account has been switched off. Ask the administrator."
                }
              }
            }
          },
          "429": {
            "description": "Too many wrong passwords for this email in 10 minutes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Too many failed attempts. Try again in a few minutes."
                }
              }
            }
          }
        },
        "x-dcrs-kind": "sign-in"
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Sign-in"
        ],
        "operationId": "logout",
        "summary": "Sign out (DCRS's own, unchanged)",
        "description": "Writes \"Signed out\" in DCRS's activity log when the session is valid. The token itself stays valid until it expires; the assistant should simply forget it.",
        "responses": {
          "204": {
            "description": "Signed out."
          }
        },
        "x-dcrs-kind": "sign-in"
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "openApi",
        "summary": "This description",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "x-dcrs-kind": "read"
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "me",
        "summary": "READ — who is signed in",
        "description": "The person's stable id (keep it as users.external_id in the assistant), name, email, role and departments.",
        "responses": {
          "200": {
            "description": "The signed-in person.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                },
                "example": {
                  "id": "3f1c2d4e-5b6a-4c7d-8e9f-0a1b2c3d4e5f",
                  "name": "Kajal Shah",
                  "email": "kajal.shah@gpp.local",
                  "role": "staff",
                  "departments": [
                    "QA"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/PasswordChangeRequired"
          }
        },
        "x-dcrs-kind": "read"
      }
    },
    "/api/v1/findings": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "listFindings",
        "summary": "READ — list and search the internal CAPA findings",
        "description": "Newest reports first. Quality Assurance's: an account kept to other departments is refused (403). Only live records.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Status"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Reports dated on or after this day.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Reports dated on or before this day.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "At most this many (1 to 200; more is read as 200).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching findings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingList"
                },
                "example": {
                  "findings": [
                    {
                      "id": "CAPA-2023-12-13-2",
                      "ref": "gap-2023-12-13:finding-mu5el1mw-2-wjv91h",
                      "recordId": "gap-2023-12-13",
                      "number": 2,
                      "reportDate": "2023-12-13",
                      "inspectionDate": "2023-12-13",
                      "finding": "Rodent box numbering was missing at few locations inside the plant but Rodent box was already placed",
                      "comments": "Pest may enter if location misplaced",
                      "correctiveActionByContractor": "NA",
                      "correctiveActionByPlant": "Numbering to be done on walls for RBS number as per Pest control Layout",
                      "targetDate": "2023-12-31",
                      "actionDate": null,
                      "verifiedByServiceProvider": "",
                      "status": "Overdue",
                      "source": "External",
                      "reportStatus": "Submitted",
                      "department": "Quality Assurance",
                      "link": "http://dcrs-host:4000/index.html#/gap/gap-2023-12-13"
                    }
                  ],
                  "total": 1
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotYourDepartment"
          }
        },
        "x-dcrs-kind": "read"
      }
    },
    "/api/v1/findings/{id}": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "getFinding",
        "summary": "READ — one finding",
        "parameters": [
          {
            "$ref": "#/components/parameters/FindingId"
          }
        ],
        "responses": {
          "200": {
            "description": "The finding.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Finding"
                },
                "example": {
                  "id": "CAPA-2023-12-13-2",
                  "ref": "gap-2023-12-13:finding-mu5el1mw-2-wjv91h",
                  "recordId": "gap-2023-12-13",
                  "number": 2,
                  "reportDate": "2023-12-13",
                  "inspectionDate": "2023-12-13",
                  "finding": "Rodent box numbering was missing at few locations inside the plant but Rodent box was already placed",
                  "comments": "Pest may enter if location misplaced",
                  "correctiveActionByContractor": "NA",
                  "correctiveActionByPlant": "Numbering to be done on walls for RBS number as per Pest control Layout",
                  "targetDate": "2023-12-31",
                  "actionDate": null,
                  "verifiedByServiceProvider": "",
                  "status": "Overdue",
                  "source": "External",
                  "reportStatus": "Submitted",
                  "department": "Quality Assurance",
                  "link": "http://dcrs-host:4000/index.html#/gap/gap-2023-12-13"
                }
              }
            }
          },
          "404": {
            "description": "No live finding has that id or ref.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "not-found": {
                    "value": {
                      "error": "There is no CAPA finding \"CAPA-2023-12-13-9\".",
                      "code": "not-found"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotYourDepartment"
          }
        },
        "x-dcrs-kind": "read"
      }
    },
    "/api/v1/findings/{id}/close": {
      "post": {
        "tags": [
          "Change"
        ],
        "operationId": "closeFinding",
        "summary": "CHANGE — close a finding with a note",
        "description": "Exactly what DCRS's own Close button does: the finding becomes Closed with today's date (the factory's) as its date of action, and the report is saved as the page saves it (a report still Due becomes In Progress; any other keeps its status). The report's history gets an entry in the person's name with the note \"Through <X-Client-Name>: <note>\", and DCRS's activity log gets a \"Record edited\" line saying the same. Refused when the finding is already closed, when its report is verified (reopen it in DCRS with Edit first) or sent back (Resume it in DCRS first).",
        "parameters": [
          {
            "$ref": "#/components/parameters/FindingId"
          },
          {
            "$ref": "#/components/parameters/ClientName"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloseRequest"
              },
              "example": {
                "note": "Rodent box numbers painted on the walls as per the layout."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Closed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloseResponse"
                },
                "example": {
                  "finding": {
                    "id": "CAPA-2023-12-13-2",
                    "ref": "gap-2023-12-13:finding-mu5el1mw-2-wjv91h",
                    "recordId": "gap-2023-12-13",
                    "number": 2,
                    "reportDate": "2023-12-13",
                    "inspectionDate": "2023-12-13",
                    "finding": "Rodent box numbering was missing at few locations inside the plant but Rodent box was already placed",
                    "comments": "Pest may enter if location misplaced",
                    "correctiveActionByContractor": "NA",
                    "correctiveActionByPlant": "Numbering to be done on walls for RBS number as per Pest control Layout",
                    "targetDate": "2023-12-31",
                    "actionDate": "2026-09-29",
                    "verifiedByServiceProvider": "",
                    "status": "Closed",
                    "source": "External",
                    "reportStatus": "Submitted",
                    "department": "Quality Assurance",
                    "link": "http://dcrs-host:4000/index.html#/gap/gap-2023-12-13"
                  },
                  "record": {
                    "id": "gap-2023-12-13",
                    "status": "Submitted"
                  },
                  "history": {
                    "at": "2026-09-29T12:17:07.380Z",
                    "by": "Kajal Shah",
                    "note": "Through Audit Assistant: Rodent box numbers painted on the walls as per the layout."
                  }
                }
              }
            }
          },
          "400": {
            "description": "The note is missing, empty or longer than 1000 characters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "bad-note": {
                    "value": {
                      "error": "A note of 1 to 1000 characters is required: say how the finding was resolved.",
                      "code": "bad-note"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No live finding has that id or ref.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "not-found": {
                    "value": {
                      "error": "There is no CAPA finding \"CAPA-2023-12-13-9\".",
                      "code": "not-found"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Refused by DCRS's own rules, or the records kept changing (try again).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "already-closed": {
                    "value": {
                      "error": "Finding CAPA-2023-12-13-2 is already closed.",
                      "code": "already-closed"
                    }
                  },
                  "report-verified": {
                    "value": {
                      "error": "The report of finding CAPA-2023-12-13-2 is verified. In DCRS, open it and use \"Edit\" to reopen it for correction first.",
                      "code": "report-verified"
                    }
                  },
                  "report-sent-back": {
                    "value": {
                      "error": "The report of finding CAPA-2023-12-13-2 was sent back. In DCRS, open it and use \"Resume\" first.",
                      "code": "report-sent-back"
                    }
                  },
                  "busy": {
                    "value": {
                      "error": "The records kept changing while this was being saved. Try again in a moment.",
                      "code": "busy"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotYourDepartment"
          }
        },
        "x-dcrs-kind": "change"
      }
    },
    "/api/v1/complaints": {
