        "responses": {
          "200": {
            "description": "The matching complaints.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintList"
                },
                "example": {
                  "complaints": [
                    {
                      "recordId": "rec-mu9x1k2p-4-ab12cd",
                      "complaintNumber": "26-27/001",
                      "customerName": "Shree Foods",
