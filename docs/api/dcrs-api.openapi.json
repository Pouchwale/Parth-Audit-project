                      "approvedBy": null,
                      "approvedDate": null,
                      "link": "http://dcrs-host:4000/index.html#/gap/complaint/rec-mu9x1k2p-4-ab12cd"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotYourDepartment"
          }
        },
        "x-dcrs-kind": "read"
      }
    },
    "/api/v1/pest-control/daily-report": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "getDailyPestControlReportPdf",
        "summary": "READ — the daily pest control report (F/HR/17) of a date, as a PDF",
        "description": "DCRS's own F/HR/17 page for that date, printed exactly as its Print button prints it (A4), as the signed-in person. Human Resources': an account kept to other departments is refused (403). Takes a few seconds. DCRS's activity log gets a \"Document downloaded as PDF\" line: \"Through <X-Client-Name>: <date>\".",
        "parameters": [
          {
            "$ref": "#/components/parameters/ReportDate"
          },
          {
            "$ref": "#/components/parameters/ClientName"
          }
        ],
        "responses": {
          "200": {
            "description": "The PDF.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "example": "attachment; filename=\"F-HR-17 Daily Pest Control Monitoring Record 2026-09-28.pdf\""
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "contentMediaType": "application/pdf"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadDate"
          },
          "404": {
            "$ref": "#/components/responses/NoReport"
          },
          "503": {
            "description": "This DCRS server cannot print: no Chrome or Edge, or the app is not built.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "pdf-unavailable": {
                    "value": {
                      "error": "This DCRS server cannot print a PDF: it needs Google Chrome or Microsoft Edge installed, and the app built (npm run build).",
                      "code": "pdf-unavailable"
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "Printing took too long.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "pdf-timeout": {
                    "value": {
                      "error": "Printing the report took too long. Try again in a moment.",
                      "code": "pdf-timeout"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotYourDepartment"
          }
        },
        "x-dcrs-kind": "read"
      }
    },
    "/api/v1/pest-control/daily-report/summary": {
      "get": {
        "tags": [
          "Read"
        ],
        "operationId": "getDailyPestControlReportSummary",
