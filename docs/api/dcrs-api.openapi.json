          },
          "400": {
            "$ref": "#/components/responses/BadDate"
          },
          "404": {
            "$ref": "#/components/responses/NoReport"
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotYourDepartment"
          }
        },
        "x-dcrs-kind": "read"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "The dcrs_session cookie's value from POST /api/auth/login. Valid for 7 days."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dcrs_session"
      }
    },
    "parameters": {
      "ClientName": {
        "name": "X-Client-Name",
        "in": "header",
        "required": false,
        "description": "The calling server's name, written in DCRS's record history and activity log (\"Through Audit Assistant: ...\"). Printable characters, at most 40; a colon is dropped. Absent: \"DCRS API\".",
        "schema": {
          "type": "string",
          "maxLength": 40
        },
        "example": "Audit Assistant"
      },
      "FindingId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The readable id (CAPA-2023-12-13-1, any case) or the stable ref (<record id>:<finding id>).",
        "schema": {
          "type": "string"
        },
        "example": "CAPA-2023-12-13-2"
      },
      "ReportDate": {
        "name": "date",
        "in": "query",
        "required": true,
        "description": "The report's date, YYYY-MM-DD.",
        "schema": {
          "type": "string",
          "format": "date"
        },
        "example": "2026-09-28"
      },
      "Status": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "open",
            "closed",
            "all"
          ],
          "default": "open"
        }
      },
      "Search": {
        "name": "q",
        "in": "query",
        "required": false,
        "description": "Text to look for (any case), at most 200 characters.",
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "responses": {
      "NotSignedIn": {
        "description": "No session, a session that has ended (7 days), or an account switched off. Sign in again.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "not-signed-in": {
                "value": {
                  "error": "Not signed in, or the session has ended. Sign in again with POST /api/auth/login.",
                  "code": "not-signed-in"
                }
              }
            }
          }
        }
      },
      "PasswordChangeRequired": {
        "description": "The account is still on the password the administrator gave it. The person must sign in to DCRS in a browser and choose their own.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "password-change-required": {
                "value": {
                  "error": "This account is still on the password the administrator gave it. Sign in to DCRS in a browser and choose your own first.",
                  "code": "password-change-required"
                }
              }
            }
          }
        }
      },
      "NotYourDepartment": {
        "description": "The person's departments do not include the one that owns these records.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "not-your-department": {
                "value": {
                  "error": "The CAPA findings belong to Quality Assurance, and this account is not kept to it.",
                  "code": "not-your-department"
                }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "A query value is not one this route accepts.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "bad-request": {
                "value": {
                  "error": "status must be \"open\", \"closed\" or \"all\".",
                  "code": "bad-request"
                }
              }
            }
          }
        }
      },
      "BadDate": {
        "description": "The date is missing or not a real date written YYYY-MM-DD.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "bad-date": {
                "value": {
                  "error": "date must be a date written YYYY-MM-DD.",
                  "code": "bad-date"
                }
              }
            }
          }
        }
      },
      "NoReport": {
        "description": "DCRS holds no live F/HR/17 record for that date.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "no-report": {
                "value": {
                  "error": "There is no daily pest control report (F/HR/17) in DCRS for 2026-09-28.",
                  "code": "no-report"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Every refusal. `error` is a sentence to show a person; `code` is for the program.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PublicUser": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role",
          "departments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The account's stable id. Never changes; keep it as the person's id in the other system."
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "staff"
            ],
            "description": "admin is the super admin (every department)."
          },
          "departments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Department codes (QA, HR, MKT ...). An empty list means every department."
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "user",
          "mustChangePassword"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUser"
          },
          "features": {
            "type": "object",
            "description": "What this DCRS server has switched on."
          },
          "mustChangePassword": {
            "type": "boolean",
            "description": "True: the person must choose their own password in DCRS before the API will serve them (403 password-change-required)."
          }
        }
      },
      "Me": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PublicUser"
          }
        ],
        "description": "The signed-in person."
      },
      "FindingStatus": {
        "type": "string",
        "enum": [
          "Open",
          "Overdue",
          "Closed",
          "Verified"
        ],
        "description": "Closed or Verified as stored; otherwise Overdue when the target date is before the factory's today and no date of action is filled in; otherwise Open."
      },
      "Finding": {
        "type": "object",
        "description": "One internal CAPA finding (a line of a Pest Control Inspection Findings Report, owned by Quality Assurance).",
        "required": [
          "id",
          "ref",
          "recordId",
          "number",
          "status",
          "reportStatus",
          "link"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Readable id: CAPA-<report date, with b, c ... for a second or third report that day>-<number>, and .2, .3 for a repeated number. Accepted in any case.",
            "examples": [
              "CAPA-2023-12-13-1",
              "CAPA-2023-12-13b-2",
              "CAPA-2023-12-13-3.2"
            ]
          },
          "ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stable reference <record id>:<finding id>. Never changes; accepted wherever an id is."
          },
          "recordId": {
            "type": "string",
            "description": "The report (record) in DCRS."
          },
          "number": {
            "type": "integer",
            "description": "The finding's S.No, or its place in the report when it has none."
          },
          "reportDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "inspectionDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "finding": {
            "type": "string",
            "description": "What was found."
          },
          "comments": {
            "type": "string"
          },
          "correctiveActionByContractor": {
            "type": "string"
          },
          "correctiveActionByPlant": {
            "type": "string"
          },
          "targetDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "actionDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "The date the action was taken (set by a close)."
          },
          "verifiedByServiceProvider": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/FindingStatus"
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "description": "Internal or External."
          },
          "reportStatus": {
            "type": "string",
            "description": "The report's own status in DCRS (Due, In Progress, Pending Verification, Verified, Rejected ...)."
          },
          "department": {
            "type": [
              "string",
              "null"
            ]
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "Opens the report in DCRS."
          }
        }
      },
      "FindingList": {
        "type": "object",
        "required": [
          "findings",
          "total"
        ],
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "total": {
            "type": "integer",
            "description": "How many match, before limit and offset."
          }
        }
      },
      "CloseRequest": {
        "type": "object",
        "required": [
          "note"
        ],
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "How the finding was resolved. Kept in the report's history."
          }
        }
      },
      "CloseResponse": {
        "type": "object",
        "required": [
          "finding",
          "record",
          "history"
        ],
        "properties": {
          "finding": {
            "$ref": "#/components/schemas/Finding"
          },
          "record": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          },
          "history": {
            "type": "object",
            "required": [
              "at",
              "by",
              "note"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "by": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      },
      "Complaint": {
        "type": "object",
        "description": "One customer complaint (CAPA — External: Customer Complaint Handling Checklist, F/MKT/05, owned by Marketing).",
        "required": [
          "recordId",
          "status",
          "recordStatus",
          "activitiesAnswered",
          "activitiesTotal",
          "link"
        ],
        "properties": {
          "recordId": {
            "type": "string"
          },
          "complaintNumber": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "jobName": {
            "type": "string"
          },
          "jobCode": {
            "type": "string"
          },
          "receivedDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "activitiesAnswered": {
            "type": "integer"
          },
          "activitiesTotal": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "Awaiting approval",
              "Closed"
            ]
          },
          "recordStatus": {
            "type": "string"
          },
          "approvedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "approvedDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "link": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ComplaintList": {
        "type": "object",
        "required": [
          "complaints"
        ],
        "properties": {
          "complaints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Complaint"
            }
          }
        }
      },
      "Checkpoint": {
        "type": "object",
        "required": [
          "number",
          "question"
        ],
        "properties": {
          "number": {
            "type": "integer"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "description": "Yes, No, a number (check point 4), or null when not answered."
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Observation": {
        "type": "object",
        "properties": {
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "actionTaken": {
            "type": "string"
          },
          "remarks": {
            "type": "string"
          }
        }
      },
      "PestSummary": {
        "type": "object",
        "description": "The Daily Pest Control Monitoring Record (F/HR/17) of one date, as data.",
        "required": [
          "date",
          "recordId",
          "status",
          "holiday",
          "checkpoints",
          "rodentsCaught",
          "observations",
          "link"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "recordId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "The record's status in DCRS. Due or Scheduled means nobody has filled it in yet."
          },
          "holiday": {
            "type": "boolean"
          },
          "checkedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeOfChecking": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Checkpoint"
            }
          },
          "rodentsCaught": {
            "type": "number"
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            }
          },
          "submittedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "verifiedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "link": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
