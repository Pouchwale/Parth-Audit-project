{
  "name": "digital-controlled-record-system",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Controlled Record System - Pest Control / Lamination QC & Production / CAPA / Compliance for Gujarat Print Pack Publications Pvt Ltd",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node --no-warnings=ExperimentalWarning scripts/dev-all.ts",
    "dev:frontend": "npm run dev --workspace=frontend",
    "server": "npm run start --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run build --workspace=frontend && npm run start --workspace=backend",
    "typecheck": "npm run typecheck --workspace=frontend && tsc -p frontend/tsconfig.test.json && tsc -p tsconfig.node.json",
    "test:unit": "node --no-warnings=ExperimentalWarning scripts/unit-tests.ts",
    "test:e2e": "node --no-warnings=ExperimentalWarning scripts/run-e2e.ts",
    "db:stop": "node --no-warnings=ExperimentalWarning scripts/db-stop.ts",
    "db:shared": "node --no-warnings=ExperimentalWarning scripts/database/shared-database.ts",
    "db:dictionary": "node --no-warnings=ExperimentalWarning scripts/database/data-dictionary.ts",
    "db:backup": "node --no-warnings=ExperimentalWarning scripts/database/backup.ts",
    "db:restore-test": "node --no-warnings=ExperimentalWarning scripts/database/restore-test.ts",
    "phone:check": "node --no-warnings=ExperimentalWarning scripts/phone-check.ts",
    "mitra:setup": "npm --prefix \"Audit project chatbot-mobile\" run setup",
    "plant:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start-plant-servers.ps1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1"
  }
}
