# DCRS server settings: backend/.env (never committed; backend/env.ts loads it at start-up, and a setting already in
# the environment wins over the file). NAMES ONLY here: put the values in backend/.env, and never print, log or commit
# that file. Every other setting, with its default: docs/DEPLOYMENT.md, "Environment configuration".

# ONE AI KEY FOR BOTH APPS (REQUIREMENTS §109). The owner's ChatGPT (OpenAI) key: Mitra's chat and agent, the checklist,
# the CV reader, pictures, the microphone and the voice all go to OpenAI, and nothing calls Groq. The Mitra server
# takes these same AI settings from this file (its DCRS_ENV_FILE) when its own environment has no OpenAI key.
CHATGPT_API_KEY=
# OPENAI_API_KEY=                (OpenAI's own name for the same key: either one; CHATGPT_API_KEY first)

# The models, each optional (the defaults in brackets; backend/ai.ts):
# AI_CHAT_MODEL=                 (gpt-5.4-mini: the chat, the history answers, the CV reader)
# AI_AGENT_MODEL=                (AI_CHAT_MODEL: Mitra's agent and its tools)
# AI_SHORT_MODEL=                (gpt-5.4-nano: a checklist answer)
# AI_VISION_MODEL=               (gpt-5.4-mini: the words in a picture)
# AI_FALLBACK_MODEL=             (gpt-4.1-mini: answers when the first model cannot; "none" for no second model)
# AI_TRANSCRIBE_MODEL=           (gpt-4o-mini-transcribe: the microphone)
# AI_TTS_MODEL=                  (gpt-4o-mini-tts: Mitra's voice)
# AI_TTS_VOICE_FEMALE=           (coral)
# AI_TTS_VOICE_MALE=             (ash)

# The cost guard: the plant's AI tokens a day, counted on this server (OpenAI is paid by the token).
# AI_DAILY_TOKEN_BUDGET=         (3000000; the chat stops at 90% and every call at 100%, until the next day)

# Switches (on unless "0"):
# CV_READ_WITH_ASSISTANT=        (an uploaded CV's gaps read by the model)
# PICTURES_READ_WITH_ASSISTANT=  (a picture attached to Mitra read by the model; "0": by OCR)

# An older setup with no OpenAI key: Groq, as before §109 (ignored whenever an OpenAI key is set).
# GROQ_API_KEY=
# GROQ_MODEL=  GROQ_AGENT_MODEL=  GROQ_TTS_MODEL=  GROQ_TTS_VOICE_FEMALE=  GROQ_TTS_VOICE_MALE=  GROQ_DAILY_TOKEN_BUDGET=
